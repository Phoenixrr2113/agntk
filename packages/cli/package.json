{
  "name": "@agntk/cli",
  "version": "1.3.0",
  "type": "module",
  "description": "CLI for agntk — portable AI agent you install and point at problems",
  "bin": {
    "agntk": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node ../../scripts/fix-esm-imports.mjs ./dist && chmod +x dist/cli.js",
    "dev": "tsc --watch",
    "test": "vitest",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agntk/core": "workspace:*",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@agntk/config-typescript": "workspace:*",
    "@types/node": "^25.6.0",
    "ai": "6.0.168",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Phoenixrr2113/agntk.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Phoenixrr2113/agntk#readme",
  "bugs": {
    "url": "https://github.com/Phoenixrr2113/agntk/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "agntk",
    "npx",
    "mcp",
    "model-context-protocol",
    "claude",
    "llm",
    "ollama",
    "zero-config",
    "developer-tools",
    "typescript",
    "ai-agent"
  ],
  "license": "MIT"
}

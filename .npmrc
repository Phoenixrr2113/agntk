# Hoist all packages to the root node_modules so Vercel's @vercel/nft
# (Node File Trace) can resolve transitive dependencies in serverless functions.
# Without this, pnpm's strict symlink structure breaks module resolution
# in Vercel's deployed serverless environment.
# See: https://github.com/withastro/astro/issues/5020
shamefully-hoist=true

